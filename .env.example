# ─────────────────────────────────────────────────────────────
#  Paskitactical — contoh konfigurasi. Salin ke .env lalu isi.
#  cp .env.example .env
#  JANGAN commit file .env yang berisi nilai asli.
# ─────────────────────────────────────────────────────────────

# Koneksi database PostgreSQL
# Contoh lokal: postgresql://postgres@127.0.0.1:5432/paskitactical?schema=public
DATABASE_URL="postgresql://user:password@host:5432/paskitactical?schema=public"

# Kunci penanda tangan sesi (JWT). WAJIB diisi.
# Buat dengan:  openssl rand -base64 32
AUTH_SECRET=""

# Identitas event. NEXT_PUBLIC_EVENT_SLUG HARUS sama dengan SEED_EVENT_SLUG.
SEED_EVENT_SLUG="lombaku-2026"
NEXT_PUBLIC_EVENT_SLUG="lombaku-2026"
SEED_EVENT_NAME="Lombaku 2026"

# Akun super admin awal (dibuat saat seed).
# Kata sandi TIDAK ditimpa bila akun sudah ada — ganti setelah login pertama.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD=""
