# ─────────────────────────────────────────────────────────────
#  Paskitactical — contoh konfigurasi. Salin ke .env lalu isi.
#  cp .env.example .env
#  JANGAN commit file .env yang berisi nilai asli.
# ─────────────────────────────────────────────────────────────

# Koneksi database PostgreSQL
# Contoh lokal: postgresql://postgres@127.0.0.1:5432/paskitactical?schema=public
DATABASE_URL="postgresql://user:password@host:5432/paskitactical?schema=public"

# Kunci penanda tangan sesi (JWT). WAJIB diisi.
# Buat dengan:  openssl rand -base64 32
AUTH_SECRET=""

# Identitas event. NEXT_PUBLIC_EVENT_SLUG HARUS sama dengan SEED_EVENT_SLUG.
SEED_EVENT_SLUG="lombaku-2026"
NEXT_PUBLIC_EVENT_SLUG="lombaku-2026"
SEED_EVENT_NAME="Lombaku 2026"

# Akun super admin awal (dibuat saat seed).
# Kata sandi TIDAK ditimpa bila akun sudah ada — ganti setelah login pertama.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD=""

# ─────────────────────────────────────────────────────────────
#  Docker (docker-compose)
# ─────────────────────────────────────────────────────────────

# Kata sandi Postgres kontainer (dipakai service db, app, backup).
# Buat dengan:  openssl rand -hex 24
LKBB_DB_PASSWORD=""

# ─────────────────────────────────────────────────────────────
#  Tunnel publik — pilih SATU provider lewat COMPOSE_PROFILES
#  Sekarang (tes): ngrok.  Nanti (produksi): cloudflare.
#  Pindah cukup UBAH DUA BARIS di sini, tanpa ubah kode.
# ─────────────────────────────────────────────────────────────
COMPOSE_PROFILES="ngrok"

# --- ngrok Free (dipakai saat COMPOSE_PROFILES=ngrok) ---
NGROK_DOMAIN="nama-domain-statis.ngrok-free.dev"
NGROK_AUTHTOKEN=""

# --- Cloudflare Tunnel (dipakai saat COMPOSE_PROFILES=cloudflare) ---
# Token dari Cloudflare Zero Trust → Networks → Tunnels (public hostname → http://app:3000).
# CLOUDFLARE_TUNNEL_TOKEN=""

# ─────────────────────────────────────────────────────────────
#  Bot ops Telegram (lkbb-bot.service — scripts/ops-bot.mjs)
# ─────────────────────────────────────────────────────────────
# Token dari @BotFather.
TELEGRAM_BOT_TOKEN=""
# Chat ID developer (hanya chat ini yang dilayani bot).
TELEGRAM_CHAT_ID=""
# Secret untuk membuka perintah krusial: kirim /unlock <secret> di chat.
PASKITACTICAL_BOT_SECRET=""
