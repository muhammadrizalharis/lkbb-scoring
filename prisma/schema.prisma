generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum SheetStatus {
  DRAFT
  FINAL
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())

  sheets    ScoreSheet[]
  auditLogs AuditLog[]
}

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  /// Sembunyikan rekap dari layar publik sampai semua tim selesai tampil.
  recapOpen Boolean  @default(false)
  /// Bila true, rubrik dikunci (lomba sudah dipublish). Diatur super admin.
  published Boolean  @default(false)
  /// Metode Juara Umum: "TOTAL_SCORE" (akumulasi nilai) atau "MEDAL_POINTS" (poin medali).
  overallMethod String @default("TOTAL_SCORE")
  goldPoints    Int    @default(3)
  silverPoints  Int    @default(2)
  bronzePoints  Int    @default(1)
  /// Berapa peringkat teratas per kategori yang mendapat medali.
  medalPlaces   Int    @default(3)
  createdAt DateTime @default(now())

  categories Category[]
  teams      Team[]
  judges     Judge[]
  sheets     ScoreSheet[]
  penalties  Penalty[]
}

model Category {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code  String
  name  String
  order Int

  /// Pengali nilai kategori saat menghitung Juara Umum.
  weight           Float   @default(1)
  includeInOverall Boolean @default(true)

  minScore Int
  maxScore Int

  groups    CriterionGroup[]
  judges    Judge[]
  sheets    ScoreSheet[]
  penalties Penalty[]

  @@unique([eventId, code])
  @@index([eventId, order])
}

model CriterionGroup {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  code  String?
  name  String
  order Int

  criteria Criterion[]

  @@index([categoryId, order])
}

model Criterion {
  id      String         @id @default(cuid())
  groupId String
  group   CriterionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name  String
  order Int
  /// Daftar nilai sah yang boleh dipilih juri untuk butir ini.
  options Int[]

  items ScoreItem[]

  @@unique([groupId, order])
}

model Judge {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  code String
  name String

  sheets ScoreSheet[]

  @@unique([eventId, code])
  @@index([categoryId])
}

model Team {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  number     Int
  name       String
  school     String?
  contingent String?

  sheets    ScoreSheet[]
  penalties Penalty[]

  @@unique([eventId, number])
  @@index([eventId, name])
}

model ScoreSheet {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  judgeId String
  judge   Judge  @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  status SheetStatus @default(DRAFT)
  /// Cache jumlah nilai butir; dihitung ulang server-side setiap penyimpanan.
  total  Int         @default(0)

  enteredById String?
  enteredBy   User?   @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  finalizedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  items ScoreItem[]

  @@unique([teamId, judgeId, categoryId])
  @@index([eventId, categoryId])
}

model ScoreItem {
  id      String     @id @default(cuid())
  sheetId String
  sheet   ScoreSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  value Int
  /// Keterangan opsional dari juri untuk butir ini (alasan nilai).
  note  String?

  @@unique([sheetId, criterionId])
}

model Penalty {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  reason String
  /// Selalu positif; dikurangkan dari total tim.
  points Int
  createdAt DateTime @default(now())

  @@index([eventId, teamId])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  detail   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
